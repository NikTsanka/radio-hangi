<?xml version="1.0" encoding="utf-8"?>
<!-- Stylized Earth for the World tab: a blue ocean globe with bold green continents.
     Continents are clipped to the globe circle so they read as real landmasses (not dots),
     even at nav-bar size. Drawn untinted (via Image) so it keeps its colors in every theme. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Ocean globe -->
    <path
        android:fillColor="#1E88E5"
        android:pathData="M12,1.5 a10.5,10.5 0 1,0 0,21 a10.5,10.5 0 1,0 0,-21 Z" />

    <group>
        <clip-path android:pathData="M12,1.5 a10.5,10.5 0 1,0 0,21 a10.5,10.5 0 1,0 0,-21 Z" />

        <!-- Left landmass (Americas-like): a tall wavy continent. -->
        <path
            android:fillColor="#43A047"
            android:pathData="M10.5,1 C7.5,2 7,5 8.2,7 C9.4,9 7.4,10 6.4,12 C5.4,14 6.4,17.5 8.6,20 C9.8,21.4 11.2,20.6 10.6,18.4 C10,16.2 11.8,15 11.4,12 C11,9 12.8,8 11.6,5 C11.1,3.7 12,2 10.5,1 Z" />

        <!-- Right landmass (Africa/Eurasia-like): a broad continent. -->
        <path
            android:fillColor="#388E3C"
            android:pathData="M14,4.5 C16.5,3.5 19.5,5 19.6,8 C19.7,10.5 16.6,11 15.4,13 C14.2,15 15.4,17.5 13.2,17.6 C11.8,17.7 12.6,14.5 13,12 C13.4,9.6 11.8,8.4 13,6 C13.4,5.2 13.2,4.8 14,4.5 Z" />

        <!-- Small southern island. -->
        <path
            android:fillColor="#66BB6A"
            android:pathData="M14.5,19 C15.8,18.6 17,19.6 16.4,20.8 C15.9,21.8 14.2,21.6 13.9,20.4 C13.7,19.7 13.8,19.2 14.5,19 Z" />
    </group>
</vector>
